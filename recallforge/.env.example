# ─── Core ──────────────────────────────────────────────────────────────
# Postgres 15+ with the pgvector extension (Supabase, Neon, RDS, local).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recallforge"
# Direct (non-pooled) connection used by migrations. Same as DATABASE_URL locally.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recallforge"
# Public base URL (no trailing slash). Used for OAuth callbacks, emails and Stripe redirects.
APP_URL="http://localhost:3000"
# Random 32+ character string. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# ─── AI provider ───────────────────────────────────────────────────────
# anthropic | openai | mock   (mock = offline heuristics for tests/dev; disabled in production)
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Optional overrides. Anthropic defaults: generate=claude-opus-5-5, fast=claude-haiku-4-5.
# Required when AI_PROVIDER=openai.
AI_MODEL_GENERATE=""
AI_MODEL_FAST=""
# Optional price overrides for cost tracking: '{"model-id":[inputUSDperM, outputUSDperM]}'
AI_PRICE_OVERRIDES=""
# local (lexical hashing, no key needed) | openai (text-embedding-3-small, true semantic search)
EMBEDDING_PROVIDER="local"

# ─── File storage ──────────────────────────────────────────────────────
# local | s3   (s3 works with AWS S3, Cloudflare R2, Supabase Storage S3 endpoint)
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR=".data/uploads"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Background jobs ───────────────────────────────────────────────────
# true = process jobs inside the web server process (dev / single long-running server).
# false = run `npm run worker` separately, or rely on the /api/cron/jobs endpoint.
INLINE_JOBS="true"
# Bearer token for /api/cron/* (Vercel Cron sends it automatically when set as CRON_SECRET).
CRON_SECRET=""

# ─── Authentication ────────────────────────────────────────────────────
# Google OAuth (optional). Redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated emails that get the admin dashboard.
ADMIN_EMAILS=""

# ─── Email (optional; without it, emails are printed to the server log) ─
RESEND_API_KEY=""
EMAIL_FROM="RecallForge <no-reply@example.com>"
SUPPORT_EMAIL="support@example.com"

# ─── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""   # recurring $15/month price id
STRIPE_PRICE_PRO_YEARLY=""    # recurring $120/year price id
# Development only: lets you test the upgrade flow without Stripe. Ignored when NODE_ENV=production.
ALLOW_DEV_BILLING="false"

# ─── Admin cost assumptions (for the contribution-margin metric) ───────
STORAGE_COST_PER_GB_MONTH="0.015"
INFRA_MONTHLY_COST_USD="0"
